# Bi-directional dshot version of ALX AP02
include ../ALXAP02/hwdef.dat

undef PC7 PB0 PB1 PA0 PA1 PA15 PD12 PD13 PD14 PD15 PE5 PE6     # pins being changed

PC7 USART6_RX USART6 NODMA             # frees TIM3 for motors 1-2

PB0 TIM3_CH3 TIM3 PWM(1) GPIO(50) BIDIR
PB1 TIM3_CH4 TIM3 PWM(2) GPIO(51) BIDIR
PA0 TIM2_CH1 TIM2 PWM(3) GPIO(52) BIDIR
PA1 TIM2_CH2 TIM2 PWM(4) GPIO(53) BIDIR
PD12 TIM4_CH1  TIM4  PWM(7)  GPIO(56) NODMA
PD13 TIM4_CH2  TIM4  PWM(8)  GPIO(57) NODMA
PD14 TIM4_CH3  TIM4  PWM(9)  GPIO(58) NODMA
PD15 TIM4_CH4  TIM4  PWM(10) GPIO(59) NODMA
PE5  TIM15_CH1 TIM15 PWM(11) GPIO(60) NODMA
PE6  TIM15_CH2 TIM15 PWM(12) GPIO(61) NODMA

PA15 BUZZER OUTPUT GPIO(32) LOW        # no buzzer fitted; plain GPIO frees TIM2
define HAL_BUZZER_PIN 32

DMA_NOSHARE SPI1* SPI4* TIM3* TIM2* TIM5* TIM4*     # hw definition file for processing by chibios_pins.py
